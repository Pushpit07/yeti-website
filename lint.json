assName=\"absolute inset-0 bg-gradient-to-br from-primary/20 via-primary/5 to-transparent\" />\r\n        <div className=\"absolute inset-0\">\r\n          <div className=\"absolute top-10 left-1/4 w-64 h-64 bg-primary/10 rounded-full blur-3xl\" />\r\n          <div className=\"absolute bottom-10 right-1/4 w-80 h-80 bg-primary/10 rounded-full blur-3xl\" />\r\n        </div>\r\n\r\n        <div className=\"mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-12 xl:px-4 2xl:px-0 relative z-10\">\r\n          <h2 className=\"text-3xl md:text-5xl lg:text-6xl font-bold text-center mb-16 tracking-tight\">\r\n            YETI by the <span className=\"bg-gradient-to-r from-primary to-primary-hover bg-clip-text text-transparent\">numbers</span>\r\n          </h2>\r\n\r\n          <div className=\"grid md:grid-cols-4 gap-8\">\r\n            <div className=\"text-center bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10 hover:border-primary/50 transition-all\">\r\n              <div className=\"text-5xl md:text-6xl font-bold bg-gradient-to-br from-primary to-primary-hover bg-clip-text text-transparent mb-3\">2</div>\r\n              <div className=\"text-white/80 font-medium\">Cities</div>\r\n            </div>\r\n            <div className=\"text-center bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10 hover:border-primary/50 transition-all\">\r\n              <div className=\"text-5xl md:text-6xl font-bold bg-gradient-to-br from-primary to-primary-hover bg-clip-text text-transparent mb-3\">50+</div>\r\n              <div className=\"text-white/80 font-medium\">Projects</div>\r\n            </div>\r\n            <div className=\"text-center bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10 hover:border-primary/50 transition-all\">\r\n              <div className=\"text-5xl md:text-6xl font-bold bg-gradient-to-br from-primary to-primary-hover bg-clip-text text-transparent mb-3\">100+</div>\r\n              <div className=\"text-white/80 font-medium\">Active Members</div>\r\n            </div>\r\n            <div className=\"text-center bg-white/5 backdrop-blur-sm rounded-2xl p-6 border border-white/10 hover:border-primary/50 transition-all\">\r\n              <div className=\"text-5xl md:text-6xl font-bold bg-gradient-to-br from-primary to-primary-hover bg-clip-text text-transparent mb-3\">€1M+</div>\r\n              <div className=\"text-white/80 font-medium\">Revenue by YETI Teams</div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </section>\r\n    </div>\r\n  )\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jains\\Desktop\\Projects\\Yeti Website\\yeti-website\\components\\ApplicationCTA.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jains\\Desktop\\Projects\\Yeti Website\\yeti-website\\components\\ApplyNowButton.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jains\\Desktop\\Projects\\Yeti Website\\yeti-website\\components\\ApplyPageView.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jains\\Desktop\\Projects\\Yeti Website\\yeti-website\\components\\BackgroundVideo.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jains\\Desktop\\Projects\\Yeti Website\\yeti-website\\components\\BenefitsSection.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jains\\Desktop\\Projects\\Yeti Website\\yeti-website\\components\\BlogContentClient.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'node' is defined but never used.","line":50,"column":31,"nodeType":null,"messageId":"unusedVar","endLine":50,"endColumn":35},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'node' is defined but never used.","line":51,"column":31,"nodeType":null,"messageId":"unusedVar","endLine":51,"endColumn":35},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'node' is defined but never used.","line":52,"column":31,"nodeType":null,"messageId":"unusedVar","endLine":52,"endColumn":35},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'node' is defined but never used.","line":54,"column":31,"nodeType":null,"messageId":"unusedVar","endLine":54,"endColumn":35}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// components/BlogContentClient.tsx\r\n'use client'\r\nimport { useState, useMemo } from 'react'\r\nimport ReactMarkdown from 'react-markdown' \r\n// 💡 New imports for robust formatting:\r\nimport remarkGfm from 'remark-gfm'\r\nimport rehypeRaw from 'rehype-raw' \r\n\r\nconst MAX_PREVIEW_HEIGHT = 160 \r\n\r\nexport function BlogContentClient({\r\n  markdownContent,\r\n  isInitiallyCollapsed = true\r\n}: {\r\n  markdownContent: string,\r\n  isInitiallyCollapsed?: boolean\r\n}) {\r\n  const [isExpanded, setIsExpanded] = useState(!isInitiallyCollapsed)\r\n\r\n  // Use a transition height large enough for expanded blogs\r\n  const maxHeightStyle = useMemo(() => ({\r\n    maxHeight: isExpanded ? '5000px' : `${MAX_PREVIEW_HEIGHT}px`\r\n  }), [isExpanded])\r\n\r\n  const handleToggle = () => {\r\n    setIsExpanded(prev => !prev)\r\n  }\r\n\r\n  const isContentAvailable = markdownContent && markdownContent.length > 0\r\n  if (!isContentAvailable) return null\r\n\r\n  return (\r\n    <div className=\"flex flex-col\">\r\n      <div className=\"relative\">\r\n        <div \r\n            className=\"transition-all duration-500 ease-in-out overflow-hidden\"\r\n            style={maxHeightStyle}\r\n        >\r\n            {/* Renders the markdown content from the sheet cell */}\r\n            <div className=\"prose prose-lg max-w-none text-gray-700 dark:text-gray-300\">\r\n                <ReactMarkdown\r\n                    // 💡 USE PLUGINS HERE for GFM features and raw HTML (line breaks)\r\n                    remarkPlugins={[remarkGfm]}\r\n                    rehypePlugins={[rehypeRaw]}\r\n                    // Force the Markdown parser to recognize double spaces at the end of a line as a <br/>\r\n                    // This often helps with single line breaks in simple lists.\r\n                    components={{\r\n                        // You can customize HTML elements here if needed, \r\n                        // e.g., to ensure h2 is always black\r\n                        h2: ({node, ...props}) => <h2 className=\"text-black\" {...props} />,\r\n                        h3: ({node, ...props}) => <h3 className=\"text-black\" {...props} />,\r\n                        ul: ({node, ...props}) => <ul className=\"pl-5 list-disc\" {...props} />,\r\n                        // Add automatic line breaks for better formatting control\r\n                        br: ({node, ...props}) => <br {...props} />\r\n                    }}\r\n                >\r\n                    {/* Replace double space line breaks with two line breaks to force a paragraph break in standard Markdown */}\r\n                    {markdownContent.replace(/ {2}\\n/g, '\\n\\n')}\r\n                </ReactMarkdown>\r\n            </div>\r\n        </div>\r\n\r\n        {/* Gradient Overlay */}\r\n        {!isExpanded && markdownContent.length > 200 && ( \r\n          <div className=\"absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-white to-transparent pointer-events-none\" />\r\n        )}\r\n      </div>\r\n\r\n      {(markdownContent.length > 300 || markdownContent.includes('\\n\\n')) && ( // Better logic: check if content is long OR has forced paragraphs\r\n        <button \r\n          onClick={handleToggle}\r\n          className=\"mt-4 text-sm font-bold text-blue-600 hover:text-blue-800 uppercase tracking-wide transition-colors self-start\"\r\n        >\r\n          {isExpanded ? \"Read Less\" : \"Read More\"}\r\n        </button>\r\n      )}\r\n    </div>\r\n  )\r\n}","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jains\\Desktop\\Projects\\Yeti Website\\yeti-website\\components\\BookZoomCallCTA.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jains\\Desktop\\Projects\\Yeti Website\\yeti-website\\components\\Button.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jains\\Desktop\\Projects\\Yeti Website\\yeti-website\\components\\ConditionalLayout.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\jains\\Desktop\\Projects\\Yeti Website\\yeti-website\\components\\ContactSection.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'Link' is defined but never used.","line":1,"column":8,"nodeType":null,"messageId":"unusedVar","endLine":1,"endColumn":12},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'city' is defined but never used.","line":9,"column":54,"nodeType":null,"messageId":"unusedVar","endLine":9,"endColumn":58}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import Link fro